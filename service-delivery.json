{
  "schemaVersion": 1,
  "projectId": "task",
  "targetRef": "refs/heads/main",
  "validation": [["npm", "ci", "--ignore-scripts", "--no-audit", "--no-fund"], ["npm", "test"]],
  "build": {
    "argv": ["node", "--check", "src/server.js"],
    "artifactPaths": ["src", "web", "roles/commander.md", "roles/owner.md", "module.json", "deploy", "package.json", "package-lock.json", "node_modules"]
  },
  "delivery": {
    "adapter": "github-actions-v1",
    "environment": "production",
    "busyPolicy": "wait-no-force",
    "healthPath": "/health",
    "versionPath": "/version"
  }
}
