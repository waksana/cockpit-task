{
  "apiVersion": 1,
  "id": "cockpit-task",
  "name": "Task",
  "version": "0.1.13",
  "backend": "src/task-board/module.js",
  "frontend": {
    "entry": "web/task-board/index.js",
    "styles": [
      "web/task-board/style.css"
    ],
    "assets": [
      "web/task-board/index.js",
      "web/task-board/style.css",
      "src/task-board/reference.js"
    ]
  },
  "roles": [
    {
      "id": "node",
      "name": "Node",
      "description": "Deliver your Task directly or through Subtasks you orchestrate; without a Task, stay available and delegate through Tasks.",
      "instructions": "roles/task-node.md",
      "skillDirectories": [
        "skills/cockpit-task-tree",
        "skills/github-coding"
      ],
      "mcpServers": {
        "cockpit-task": {
          "type": "http",
          "path": "/mcp",
          "tools": [
            "task_read",
            "task_create",
            "task_script_register",
            "task_script_read",
            "task_automation_start",
            "task_automation_reconcile",
            "task_session_create",
            "task_session_prepare",
            "task_assign",
            "task_edit",
            "task_cancel",
            "task_subscribe",
            "task_unsubscribe",
            "task_ack",
            "task_reopen",
            "task_report",
            "task_retro_handle"
          ]
        }
      }
    }
  ]
}
