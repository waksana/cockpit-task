[Unit]
Description=Work Commander private work service
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/work-commander/current
ExecStart=%h/.local/bin/node %h/.local/share/work-commander/current/src/launch.js
Environment=NODE_ENV=production
EnvironmentFile=-%h/.config/work-commander/service.env
Restart=on-failure
RestartSec=3
TimeoutStopSec=75
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/work-commander
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
